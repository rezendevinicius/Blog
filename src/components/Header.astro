---
import { SITE_TITLE } from '../consts';

const caminho = Astro.url.pathname;

const links = [
	{ href: '/aulas/', texto: 'Aulas' },
	{ href: '/literatura/', texto: 'Literatura' },
	{ href: '/busca/', texto: 'Busca' },
	{ href: '/about/', texto: 'Sobre' },
].map((link) => ({
	...link,
	classe: caminho.startsWith(link.href) ? 'text-teal-700 dark:text-teal-400' : 'text-stone-600 dark:text-stone-400',
}));
---

<header class="border-b border-stone-200 dark:border-stone-800">
	<nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
		<a href="/" class="flex items-center gap-2">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 31" class="h-7 w-auto text-teal-600" fill="currentColor" aria-hidden="true">
				<rect x="5" y="1" width="14" height="3" rx="0.6" />
				<rect x="9" y="4" width="6" height="4" />
				<ellipse cx="12" cy="13.5" rx="7" ry="6" />
				<rect x="10" y="18" width="4" height="4" />
				<ellipse cx="12" cy="23.5" rx="5" ry="2.6" />
				<rect x="6" y="26" width="12" height="3.5" rx="0.6" />
			</svg>
			<span class="font-serif text-xl font-semibold text-stone-900 dark:text-stone-100">{SITE_TITLE}</span>
		</a>

		<ul class="flex gap-6 text-sm font-medium">
			{
				links.map((link) => (
					<li><a href={link.href} class={'hover:text-teal-700 dark:hover:text-teal-400 ' + link.classe}>{link.texto}</a></li>
				))
			}
		</ul>
	</nav>
</header>