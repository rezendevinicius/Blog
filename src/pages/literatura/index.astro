---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const textos = (await getCollection('literatura')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<html lang="pt-BR">
	<head>
		<BaseHead
			title="Literatura | Balaústres"
			description="Poemas, crônicas e redações."
		/>
	</head>
	<body class="bg-stone-50 text-stone-800">
		<Header />
		<main class="mx-auto max-w-3xl px-4 py-10">
			<h1 class="text-3xl font-bold">Literatura</h1>
			<ul class="mt-8 space-y-4">
	{
		textos.map((texto) => (
			<li>
				<a href={"/literatura/" + texto.id + "/"} class="block rounded-lg border border-stone-300 p-4 hover:border-teal-600">
					<p class="text-xs font-semibold uppercase text-teal-700">{texto.data.tipo}</p>
					<h2 class="text-xl font-semibold">{texto.data.title}</h2>
					{texto.data.description && <p class="text-stone-600">{texto.data.description}</p>}
				</a>
			</li>
		))
	}
</ul>
		</main>
		<Footer />
	</body>
</html>