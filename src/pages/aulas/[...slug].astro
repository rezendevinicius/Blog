---
import { getCollection, render } from 'astro:content';
import AulaLayout from '../../layouts/AulaLayout.astro';

export async function getStaticPaths() {
	const aulas = await getCollection('aulas');
	return aulas.map((aula) => ({ params: { slug: aula.id }, props: aula }));
}

const aula = Astro.props;
const { Content, headings } = await render(aula);
---

<AulaLayout {...aula.data} headings={headings}>
	<Content />
</AulaLayout>