---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const aulas = (await getCollection('aulas')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<html lang="pt-BR">
	<head>
		<BaseHead title="Aulas | Balaústres" description="Aulas de Matemática e Física." />
	</head>
	<body class="bg-stone-50 text-stone-800">
		<Header />
		<main class="mx-auto max-w-3xl px-4 py-10">
			<h1 class="text-3xl font-bold">Aulas</h1>
			<ul class="mt-8 space-y-4">

                {
                    aulas.map((aula) => (
                        <li>
                            <a href={"/aulas/" + aula.id + "/"} class="block rounded-lg border border-stone-300 p-4 hover:border-teal-600">
                                <p class="text-xs font-semibold uppercase text-teal-700">{aula.data.disciplina}</p>
                                <h2 class="text-xl font-semibold">{aula.data.title}</h2>
                                <p class="text-stone-600">{aula.data.description}</p>
                            </a>
                        </li>
                    ))
                }

			</ul>
		</main>
		<Footer />
	</body>
</html>