---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const aulas = (await getCollection('aulas')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<html lang="pt-BR">
	<head>
		<BaseHead title="Aulas | Balaústres" description="Aulas de Matemática e Física." />
	</head>
	<body class="bg-stone-50 dark:bg-stone-950 text-stone-800 dark:text-stone-200">
		<Header />
		<main class="mx-auto max-w-3xl px-4 py-10">
			<h1 class="text-3xl font-bold">Aulas</h1>
			<ul class="mt-8 space-y-4">
				{
					aulas.map((aula) => (
						<li>
							<a href={"/aulas/" + aula.id + "/"} class="block rounded-lg border border-stone-300 dark:border-stone-700 p-4 hover:border-teal-600 dark:hover:border-teal-400">
								<p class="text-xs font-semibold uppercase text-teal-700 dark:text-teal-400">{aula.data.disciplina}</p>
								<h2 class="text-xl font-semibold">{aula.data.title}</h2>
								<p class="text-stone-600 dark:text-stone-400">{aula.data.description}</p>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>