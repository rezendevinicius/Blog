---
import { Search } from 'astro-pagefind/components';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="pt-BR">
	<head>
		<BaseHead title="Busca | Balaústres" description="Buscar no site." />
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-2xl px-4 py-10">
			<h1 class="text-3xl font-bold">Busca</h1>
			<div class="mt-8">
				<Search id="busca" className="pagefind-ui" uiOptions={{ showImages: false }} />
			</div>
		</main>
		<Footer />
	</body>
</html>